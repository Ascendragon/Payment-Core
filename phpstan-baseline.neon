parameters:
	ignoreErrors:
		-
			message: '#^Property App\\Application\\Transfer\\TransferService\:\:\$messageBroker is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Application/Transfer/TransferService.php

		-
			message: '#^Parameter \#1 \$num1 of function bccomp expects numeric\-string, string given\.$#'
			identifier: argument.type
			count: 2
			path: src/Domain/Money.php

		-
			message: '#^Parameter \#1 \$num1 of function bcsub expects numeric\-string, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Domain/Money.php

		-
			message: '#^Parameter \#2 \$num2 of function bccomp expects numeric\-string, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Domain/Money.php

		-
			message: '#^Parameter \#2 \$num2 of function bcsub expects numeric\-string, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Domain/Money.php

		-
			message: '#^Method App\\Entity\\Account\:\:getId\(\) should return int\|null but returns string\|null\.$#'
			identifier: return.type
			count: 1
			path: src/Entity/Account.php

		-
			message: '#^Property App\\Entity\\Account\:\:\$balance type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/Account.php

		-
			message: '#^Property App\\Entity\\Account\:\:\$currency type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/Account.php

		-
			message: '#^Property App\\Entity\\Account\:\:\$version type mapping mismatch\: property can contain int\|null but database expects int\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/Account.php

		-
			message: '#^Method App\\Entity\\AuditLog\:\:getPayload\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Entity/AuditLog.php

		-
			message: '#^Method App\\Entity\\AuditLog\:\:setPayload\(\) has parameter \$payload with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Entity/AuditLog.php

		-
			message: '#^Property App\\Entity\\AuditLog\:\:\$createdAt type mapping mismatch\: property can contain DateTimeImmutable\|null but database expects DateTimeImmutable\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/AuditLog.php

		-
			message: '#^Property App\\Entity\\AuditLog\:\:\$entityId type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/AuditLog.php

		-
			message: '#^Property App\\Entity\\AuditLog\:\:\$entityType type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/AuditLog.php

		-
			message: '#^Property App\\Entity\\AuditLog\:\:\$eventType type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/AuditLog.php

		-
			message: '#^Property App\\Entity\\AuditLog\:\:\$payload type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Entity/AuditLog.php

		-
			message: '#^Property App\\Entity\\IdempotencyKey\:\:\$key type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/IdempotencyKey.php

		-
			message: '#^Property App\\Entity\\IdempotencyKey\:\:\$requestHash type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/IdempotencyKey.php

		-
			message: '#^Property App\\Entity\\IdempotencyKey\:\:\$status type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/IdempotencyKey.php

		-
			message: '#^Method App\\Entity\\OutboxMessage\:\:getPayload\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Entity/OutboxMessage.php

		-
			message: '#^Method App\\Entity\\OutboxMessage\:\:setPayload\(\) has parameter \$payload with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Entity/OutboxMessage.php

		-
			message: '#^Property App\\Entity\\OutboxMessage\:\:\$created_at type mapping mismatch\: property can contain DateTimeImmutable\|null but database expects DateTimeImmutable\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/OutboxMessage.php

		-
			message: '#^Property App\\Entity\\OutboxMessage\:\:\$event_class type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/OutboxMessage.php

		-
			message: '#^Property App\\Entity\\OutboxMessage\:\:\$id \(int\|null\) does not accept Symfony\\Component\\Uid\\Uuid\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Entity/OutboxMessage.php

		-
			message: '#^Property App\\Entity\\OutboxMessage\:\:\$payload type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Entity/OutboxMessage.php

		-
			message: '#^Property App\\Entity\\OutboxMessage\:\:\$status type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/OutboxMessage.php

		-
			message: '#^Property App\\Entity\\Payment\:\:\$amount type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/Payment.php

		-
			message: '#^Property App\\Entity\\Payment\:\:\$status type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/Payment.php

		-
			message: '#^Method App\\EventSubscriber\\ApiExceptionSubscriber\:\:resolveStatusAndMessage\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/EventSubscriber/ApiExceptionSubscriber.php

		-
			message: '#^Cannot access offset ''request_hash'' on array\<string, mixed\>\|false\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Infrastructure/Idempotency/DbalIdempotencyStore.php

		-
			message: '#^Method App\\MessageHandler\\TransferCompletedHandler\:\:__invoke\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/MessageHandler/TransferCompletedHandler.php

		-
			message: '#^Cannot access offset ''balance'' on array\<string, mixed\>\|false\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: tests/Controller/TransferControllerTest.php

		-
			message: '#^Method App\\Tests\\Controller\\TransferControllerTest\:\:provideBadTransferData\(\) return type has no value type specified in iterable type iterable\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Controller/TransferControllerTest.php

		-
			message: '#^Method App\\Tests\\Controller\\TransferControllerTest\:\:testSuccesfulTransfer\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: tests/Controller/TransferControllerTest.php

		-
			message: '#^Method App\\Tests\\Controller\\TransferControllerTest\:\:testTransferValidationFails\(\) has parameter \$payload with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Controller/TransferControllerTest.php

		-
			message: '#^Parameter \#2 \$actualJson of method PHPUnit\\Framework\\Assert\:\:assertJsonStringEqualsJsonString\(\) expects string, string\|false given\.$#'
			identifier: argument.type
			count: 3
			path: tests/Controller/TransferControllerTest.php

		-
			message: '#^Parameter \#6 \$content of method Symfony\\Component\\BrowserKit\\AbstractBrowser\<Symfony\\Component\\HttpFoundation\\Request,Symfony\\Component\\HttpFoundation\\Response\>\:\:request\(\) expects string\|null, string\|false given\.$#'
			identifier: argument.type
			count: 8
			path: tests/Controller/TransferControllerTest.php

		-
			message: '#^Call to function method_exists\(\) with ''Symfony\\\\Component\\\\Dotenv\\\\Dotenv'' and ''bootEnv'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: tests/bootstrap.php
